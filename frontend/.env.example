# Copie pra ".env" (não versionado) e ajuste os valores. O Vite só expõe
# variáveis prefixadas com VITE_, e as substitui em tempo de build.

# URL pública do backend. Sem essa variável, o frontend usa
# http://127.0.0.1:8000 (padrão de desenvolvimento local).
VITE_API_BASE=http://127.0.0.1:8000

# Opcional: DSN do Sentry, pra observabilidade de erros do frontend em
# produção. Sem essa variável, o Sentry não é inicializado (zero custo/no-op).
VITE_SENTRY_DSN=
